# ===== 基础 =====
ENVIRONMENT=development
DEBUG=true

# ===== PostgreSQL（pgvector）=====
POSTGRES_USER=pca
POSTGRES_PASSWORD=pca_password
POSTGRES_DB=phone_commerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pca:pca_password@localhost:5432/phone_commerce

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ===== LLM（DeepSeek，OpenAI 兼容协议）=====
# LLM_PROVIDER 可选值：mock | deepseek
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ===== Embedding =====
# EMBEDDING_PROVIDER 可选值：mock | local | openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=bge-m3

# ===== 安全（生产环境务必更换）=====
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Agent 执行限制 =====
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
MAX_TOKENS_PER_TURN=4000
TOOL_TIMEOUT_SECONDS=10

# ===== 服务端口 =====
API_PORT=8000
FRONTEND_PORT=5173
