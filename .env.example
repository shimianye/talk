# ===== 基础 =====
ENVIRONMENT=development
DEBUG=true

# ===== PostgreSQL（pgvector）=====
POSTGRES_USER=pca
POSTGRES_PASSWORD=pca_password
POSTGRES_DB=phone_commerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pca:pca_password@localhost:5432/phone_commerce
# 独立评测库必须与主库同实例、不同 database，且名称以 _eval 结尾
EVAL_DATABASE_URL=postgresql+asyncpg://pca:pca_password@localhost:5432/phone_commerce_eval
# 仅在手工执行 Alembic 时临时设置；不设置则使用 DATABASE_URL
ALEMBIC_DATABASE_URL=

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ===== LLM（DeepSeek，OpenAI 兼容协议）=====
# LLM_PROVIDER 可选值：mock | deepseek
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ===== Embedding =====
# EMBEDDING_PROVIDER 可选值：mock | local | openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Docker 访问宿主机 Ollama 可使用 http://host.docker.internal:11434
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== 安全（生产环境务必更换）=====
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Agent 执行限制 =====
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
MAX_TOKENS_PER_TURN=4000
TOOL_TIMEOUT_SECONDS=10

# ===== 服务端口 =====
API_PORT=8000
FRONTEND_PORT=5173
